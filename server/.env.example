# Database Configuration
# PostgreSQL connection string - Get from Supabase/Neon
DATABASE_URL="postgresql://user:password@localhost:5432/divstack_ai"
DIRECT_URL="postgresql://user:password@localhost:5432/divstack_ai"

# Authentication
# Generate a random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="your_generated_secret_here"
BETTER_AUTH_URL="http://localhost:3000"

# AI Services
# Get API key from https://build.nvidia.com
AI_API_KEY="your_nvidia_api_key_here"

# DeepSeek API
DEEPSEEK_API_KEY="your_deepseek_api_key_here"

# CORS Configuration (optional)
# Comma-separated list of trusted origins
TRUSTED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Stripe (optional)
STRIPE_SECRET_KEY="your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="your_stripe_publishable_key"